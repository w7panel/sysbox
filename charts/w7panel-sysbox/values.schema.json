{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "installMode": {
      "type": "string",
      "enum": ["host", "nested"]
    },
    "nested": {
      "type": "object",
      "properties": {
        "pauseImage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["pauseImage"]
    }
  },
  "required": ["installMode", "nested"]
}
