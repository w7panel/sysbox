{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "installMode": {
      "type": "string",
      "enum": ["host", "nested"]
    },
    "nested": {
      "type": "object",
      "properties": {
        "pauseImage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["pauseImage"]
    },
    "installer": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string" }
          },
          "required": ["repository"]
        }
      }
    },
    "admission": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "digest": { "type": "string" }
          }
        }
      }
    }
  },
  "required": ["installMode", "nested"]
}
